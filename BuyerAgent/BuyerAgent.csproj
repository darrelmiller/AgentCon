<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="A2A" Version="1.0.0-preview3" />
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview3" />
    <PackageReference Include="Agntcy.SlimA2A" Version="0.6.2" />
    <PackageReference Include="Agntcy.Slim.SlimRpc" Version="3.3.6" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.19" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ExchangeDashboard.html" />
    <EmbeddedResource Include="..\SupplierAgent\schemas\wine-v1.schema.json" Link="WineSchema.json" LogicalName="BuyerAgent.WineSchema.json" />
    <!-- Default Buyer:CatalogUrl: the live repository catalog.json, not a copy in the build output. -->
    <AssemblyMetadata Include="AgentConRepositoryCatalog" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\catalog.json'))" />
  </ItemGroup>
</Project>
